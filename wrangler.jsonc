{
  // Cloudflare deploys this project as a Worker that serves static assets.
  // `npm run build` writes the exported site to ./out (see next.config.ts),
  // and everything below just points Wrangler at that folder. There is no
  // `main` entry: this is an assets-only Worker, so no server code runs.
  "name": "magneto-partners",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./out",
    // next.config.ts sets trailingSlash: true, so /about/ maps to
    // out/about/index.html and /about redirects to it.
    "html_handling": "auto-trailing-slash",
    // Serve the exported out/404.html for anything that doesn't match.
    "not_found_handling": "404-page"
  }
}
